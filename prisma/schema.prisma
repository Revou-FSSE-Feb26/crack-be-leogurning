generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  generatedFileExtension = "ts"
  importFileExtension    = ""
  moduleFormat           = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  fullName         String?
  role             Role              @default(CLIENT)
  phone            String?
  dateOfBirth      DateTime?
  emergencyContact String?
  avatarUrl        String?
  counselorId      String?           @unique
  isActive         Boolean           @default(true)
  refreshToken     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdBy        String
  updatedBy        String
  appointments     Appointment[]
  notifications    Notification[]
  counselorProfile CounselorProfile? @relation(fields: [counselorId], references: [id])

  @@index([email])
  @@map("users")
}

model CounselorProfile {
  id                       String                    @id @default(uuid())
  userId                   String                    @unique
  licenseNumber            String                    @unique
  availability             String[]
  rating                   Decimal                   @default(0) @db.Decimal(10, 2)
  reviewCount              Int                       @default(0)
  languages                String[]
  isAvailable              Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  createdBy                String
  updatedBy                String
  appointments             Appointment[]
  counselorSchedules       CounselorSchedule[]
  counselorSpecializations CounselorSpecialization[]
  sessionTypeConfigs       SessionTypeConfig[]
  user                     User?

  @@index([userId])
  @@map("counselor_profiles")
}

model Specialization {
  id                       String                    @id @default(uuid())
  name                     String                    @unique
  description              String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  createdBy                String
  updatedBy                String
  counselorSpecializations CounselorSpecialization[]

  @@map("specializations")
}

model AppointmentSessionType {
  id                 String              @id @default(uuid())
  name               String
  durationMinutes    Int
  price              Decimal             @db.Decimal(10, 2)
  tier               Int
  isOnline           Boolean
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdBy          String
  updatedBy          String
  sessionTypeConfigs SessionTypeConfig[]

  @@index([isOnline])
  @@map("appointment_session_types")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model CounselorSchedule {
  id          String           @id @default(uuid())
  counselorId String
  dayOfWeek   DayOfWeek
  startTime   String
  endTime     String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   String
  updatedBy   String
  counselor   CounselorProfile @relation(fields: [counselorId], references: [id], onDelete: Cascade)

  @@unique([counselorId, dayOfWeek, startTime])
  @@index([counselorId, dayOfWeek])
  @@map("counselor_schedules")
}

model CounselorSpecialization {
  id               String           @id @default(uuid())
  counselorId      String
  specializationId String
  createdAt        DateTime         @default(now())
  createdBy        String
  counselor        CounselorProfile @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  specialization   Specialization   @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@unique([counselorId, specializationId])
  @@index([counselorId])
  @@index([specializationId])
  @@map("counselor_specializations")
}

model SessionTypeConfig {
  id                       String                 @id @default(uuid())
  counselorId              String
  sessionType              SessionType
  appointmentSessionTypeId String
  clinicAddress            String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  createdBy                String
  updatedBy                String
  appointmentSessionType   AppointmentSessionType @relation(fields: [appointmentSessionTypeId], references: [id], onDelete: Cascade)
  counselor                CounselorProfile       @relation(fields: [counselorId], references: [id], onDelete: Cascade)

  @@unique([counselorId, sessionType])
  @@index([counselorId])
  @@index([appointmentSessionTypeId])
  @@map("session_type_configs")
}

model Appointment {
  id                String            @id @default(uuid())
  clientId          String
  counselorId       String
  sessionType       SessionType
  date              DateTime
  time              String
  endTime           String
  durationMinutes   Int
  rate              Decimal           @db.Decimal(10, 2)
  status            AppointmentStatus @default(PENDING)
  meetingLink       String?
  notes             String?
  referenceCode     String?
  cancellationNotes String?
  cancelledAt       DateTime?
  cancelledBy       CancelledBy?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         String
  updatedBy         String
  client            User              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  counselor         CounselorProfile  @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  paymentProof      PaymentProof?
  review            Review?

  @@index([clientId])
  @@index([counselorId])
  @@index([status])
  @@index([date])
  @@map("appointments")
}

model PaymentProof {
  id              String             @id @default(uuid())
  appointmentId   String             @unique
  filename        String
  submittedAt     DateTime
  status          PaymentProofStatus @default(SUBMITTED)
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  createdBy       String
  updatedBy       String
  appointment     Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payment_proofs")
}

model Review {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdBy     String
  updatedBy     String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([rating])
  @@map("reviews")
}

enum Role {
  ADMIN
  COUNSELOR
  CLIENT
  ROOT
}

enum SessionType {
  ONLINE
  OFFLINE
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum AppointmentStatus {
  PENDING
  AWAITING_PAYMENT
  PAYMENT_UPLOADED
  PAYMENT_VERIFIED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  PENDING_RESCHEDULE
  REJECTED_SCHEDULE
}

enum CancelledBy {
  CLIENT
  COUNSELOR
  ADMIN
}

enum PaymentProofStatus {
  SUBMITTED
  VERIFIED
  REJECTED
}

enum NotificationType {
  APPOINTMENT_REMINDER
  PAYMENT_CONFIRMED
  PAYMENT_REJECTED
  SESSION_CANCELLED
  NEW_BOOKING
  GENERAL
}
